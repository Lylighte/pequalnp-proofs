def applyPacked (table : Array Nat) (i : Fin 120) (v : V) : V :=
  ⟨(((table[i.val]! >>> (4 * v.val)) % 16) % 10), by omega⟩

abbrev forward := applyPacked packed
abbrev backward := applyPacked packedInv

set_option maxRecDepth 4096 in
set_option maxHeartbeats 10000000 in
theorem inverses : ∀ (i : Fin 120) (v : V),
    backward i (forward i v) = v ∧ forward i (backward i v) = v := by decide +kernel

def permutation (i : Fin 120) : Equiv.Perm V :=
  ⟨forward i, backward i, fun v => (inverses i v).1, fun v => (inverses i v).2⟩

def neighborBits : Array Nat := #[50, 69, 138, 276, 521, 385, 770, 548, 104, 208]
def adjacentBit (a b : V) := neighborBits[a.val]!.testBit b.val

theorem bitMatchesGraph : ∀ a b : V, adjacentBit a b = related a b := by decide +kernel

set_option maxRecDepth 4096 in
set_option maxHeartbeats 10000000 in
theorem preserveBits : ∀ i a b, adjacentBit (forward i a) (forward i b) = adjacentBit a b := by
  decide +kernel

theorem preservesGraph (i : Fin 120) (a b : V) :
    graph.Adj (permutation i a) (permutation i b) ↔ graph.Adj a b := by
  change graph.Adj (forward i a) (forward i b) ↔ _
  rw [adjacency, adjacency, ← bitMatchesGraph, ← bitMatchesGraph a b, preserveBits]

def signature (f : V → V) := (((f 0).val * 10 + (f 1).val) * 10 + (f 2).val) * 10 + (f 3).val
def keys : Array Nat := #[123, 127, 168, 169, 432, 438, 496, 497, 572, 579, 583, 586, 1043, 1049, 1057, 1058, 1234, 1238, 1275, 1279, 1683, 1685, 1694, 1697, 2104, 2105, 2168, 2169, 2340, 2349, 2385, 2386, 2750, 2758, 2794, 2796, 3210, 3216, 3275, 3279, 3401, 3405, 3496, 3497, 3850, 3857, 3861, 3869, 4012, 4016, 4057, 4058, 4321, 4327, 4385, 4386, 4961, 4968, 4972, 4975, 5012, 5016, 5043, 5049, 5721, 5723, 5794, 5796, 5832, 5834, 5861, 5869, 6104, 6105, 6123, 6127, 6832, 6834, 6850, 6857, 6940, 6943, 6972, 6975, 7210, 7216, 7234, 7238, 7501, 7504, 7583, 7586, 7940, 7943, 7961, 7968, 8321, 8327, 8340, 8349, 8501, 8504, 8572, 8579, 8610, 8612, 8694, 8697, 9401, 9405, 9432, 9438, 9610, 9612, 9683, 9685, 9721, 9723, 9750, 9758]

set_option maxRecDepth 4096 in
set_option maxHeartbeats 10000000 in
theorem lookupCorrect : ∀ i : Fin 120, Array.idxOf (signature (forward i)) keys = i.val := by
  decide +kernel

theorem distinct : Function.Injective permutation := by
  intro i j h
  have hk := congrArg (fun e : Equiv.Perm V => Array.idxOf (signature e) keys) h
  change Array.idxOf (signature (forward i)) keys = Array.idxOf (signature (forward j)) keys at hk
  exact Fin.ext ((lookupCorrect i).symm.trans (hk.trans (lookupCorrect j)))

-- Image membership is the exact inverse-bit test for the concrete mask convention.
theorem imageMem (i : Fin 120) (m : Fin 1024) (w : V) :
    w ∈ PetersenEquivariance.vertexSet (permutation i) (PetersenBoundary.decode m) ↔
      m.val.testBit (backward i w).val = true := by
  rw [PetersenEquivariance.vertexSet, Finset.mem_map_equiv]
  simp [PetersenBoundary.decode, permutation]

end PetersenAutomorphisms

#print axioms PetersenAutomorphisms.preservesGraph
