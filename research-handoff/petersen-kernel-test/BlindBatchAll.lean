theorem cliqueSeven (l r : Mask) (h : (l,r) ∈ cliqueIds) : Seven l r := by
  obtain ⟨e,mem,eq⟩ := List.mem_map.mp h
  have hl : e.left = l := congrArg Prod.fst eq
  have hr : e.right = r := congrArg Prod.snd eq
  rw [← hl,← hr]
  exact sound e ((List.all_eq_true.mp allChecked) e mem)

def ids : List (Mask × Mask) := (50,201) :: (50,203) :: cliqueIds

theorem seven (l r : Mask) (h : (l,r) ∈ ids) : Seven l r := by
  rcases List.mem_cons.mp h with eq | h
  · cases eq
    have L : PetersenBoundary.decode 50 = FirstDemandClique.left50 := by decide +kernel
    have R : PetersenBoundary.decode 201 = FirstDemandClique.right201 := by decide +kernel
    intro C g hg l r sep cap
    exact FirstDemandClique.seven50_201 C g hg (l.trans L) (r.trans R) sep cap
  rcases List.mem_cons.mp h with eq | h
  · cases eq
    have L : PetersenBoundary.decode 50 = FirstDemandClique.left50 := by decide +kernel
    have R : PetersenBoundary.decode 203 = FirstDemandClique.right203 := by decide +kernel
    intro C g hg l r sep cap
    exact FirstDemandClique.seven50_203 C g hg (l.trans L) (r.trans R) sep cap
  exact cliqueSeven l r h

def key (p : Mask × Mask) := p.1.val*1024+p.2.val

def orderedAfter (i : ℕ) : List (Mask × Mask) → Bool
  | [] => true
  | p :: ps => decide (i < key p) && orderedAfter (key p) ps

lemma orderedDistinct (ps : List (Mask × Mask)) (i : ℕ) (h : orderedAfter i ps = true) :
    (∀ p ∈ ps, i < key p) ∧ ps.Nodup := by
  induction ps generalizing i with
  | nil => simp
  | cons a ps ih =>
    obtain ⟨smaller,tail⟩ := Bool.and_eq_true_iff.mp h
    have lt : i < key a := of_decide_eq_true smaller
    obtain ⟨below,nd⟩ := ih (key a) tail
    constructor
    · intro b hb
      rcases List.mem_cons.mp hb with rfl | hb
      · exact lt
      · exact Nat.lt_trans lt (below b hb)
    · exact List.nodup_cons.mpr ⟨fun ha => (Nat.lt_irrefl _) (below a ha),nd⟩

